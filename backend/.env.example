# RuralAI Finance Hub - Environment Variables
# Copy this file to .env and add your actual API keys

# ============================================================================
# SMS/OTP Configuration (Choose ONE provider)
# ============================================================================

# Option 1: TWILIO (Recommended - Most reliable, works internationally)
# Sign up: https://www.twilio.com/try-twilio
# Free trial: $15 credit (enough for ~500 SMS)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# Option 2: MSG91 (India-focused, affordable)
# Sign up: https://msg91.com/signup
# Free trial: 100 SMS credits
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_TEMPLATE_ID=your_msg91_template_id
MSG91_SENDER_ID=RURALAI

# Option 3: Fast2SMS (India only, budget-friendly)
# Sign up: https://www.fast2sms.com/register
# Free trial: 50 SMS credits
FAST2SMS_API_KEY=your_fast2sms_api_key

# Option 4: AWS SNS (Enterprise, high volume)
# Setup: Configure AWS credentials via AWS CLI
AWS_SNS_REGION=ap-south-1

# ============================================================================
# Email Configuration (For email OTP as alternative)
# ============================================================================

# SendGrid (Recommended for email)
# Sign up: https://signup.sendgrid.com/
# Free tier: 100 emails/day
SENDGRID_API_KEY=your_sendgrid_api_key_here
EMAIL_FROM=verified_sender@yourdomain.com
EMAIL_FROM_NAME=RuralAI Finance Hub

# Gmail SMTP (Legacy fallback - not recommended)
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_specific_password

# ============================================================================
# JWT Security
# ============================================================================
JWT_SECRET=change_this_to_a_random_secret_key_in_production

# ============================================================================
# Weather API (OpenWeatherMap - Free tier available)
# ============================================================================
# Get your key from: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Alternative: WeatherAPI.com (More generous free tier)
# Get your key from: https://www.weatherapi.com/signup.aspx
WEATHERAPI_KEY=your_weatherapi_key_here

# ============================================================================
# Market Data API (Optional - using free government sources as fallback)
# ============================================================================
AGMARKNET_API_KEY=optional_agmarknet_key

# ============================================================================
# Flask Configuration
# ============================================================================
FLASK_ENV=development
FLASK_DEBUG=True
